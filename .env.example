# ==============================================================================
# YamRail / Code_CLI - Judge & Operator Environment Configuration (.env.example)
# ==============================================================================
# [ZERO-CREDENTIAL JUDGE MODE]
# Judges do NOT need any API keys or paid credentials to evaluate this project.
# With SAMPLE_MODE=true, all 3 deterministic Track 3 fixtures and Moot checks
# run 100% offline using pinned local evidence.

SAMPLE_MODE=true

# --- Optional Live OpenAI Probe (M-J09: NOT required for judging) ---
OPENAI_API_KEY=sk-placeholder-do-not-commit-real-keys
OPENAI_MODEL=gpt-4.1-mini

# --- Optional Local COTS Gateways (Owner Workstation / Nightshift / Zetaris) ---
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=local-cots-placeholder
NIGHTSHIFT_MODEL=nemotron-local
ZETARIS_BASE_URL=http://127.0.0.1:8888
ZETARIS_TOKEN=zetaris-placeholder-token
